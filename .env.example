NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The laboratory's fixed IANA timezone. These values must match.
LAB_TIMEZONE=Asia/Shanghai
NEXT_PUBLIC_LAB_TIMEZONE=Asia/Shanghai
# Optional, server-only, and never available to Client Components.
SUPABASE_SERVICE_ROLE_KEY=server-only-key-for-trusted-operations
